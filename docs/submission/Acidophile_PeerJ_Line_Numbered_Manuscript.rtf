\par \pard\plain \s0\sl360\slmult1\widctlpar\sb0\sa240\ltrpar\hyphpar0\kerning0\cf1\rtlch\af13\afs22\alang1025\ltrch\hich\af8\afs24\alang1033\dbch\af11\langfe1033\loch\f8\fs24\lang1033\sl276\slmult1\keep\sb0\sa160{\cf1\fs24
